{
  "name": "fortaleza-survivor",
  "version": "0.2.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4183 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:sim": "node --experimental-strip-types --test tests/simulation/*.test.ts",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
